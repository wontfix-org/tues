#!/usr/bin/env python3
"""Set the workspace version, tag it, and build PyPI artifacts.

Usage: scripts/release [-d|--dry-run] [--rc | --pre]
                       [--python 3.9,3.10,3.11,3.12,3.13,3.14] [VERSION]

VERSION is a dotted release such as 0.2.0 (a leading "v" is accepted and
stripped). When omitted and stdin is a TTY, the script prints commit
summaries since the last release and prompts for a version. The script
commits the version bump, creates an annotated tag vVERSION, and writes a
release sdist plus one wheel per configured CPython to dist/<version>/.
dist/latest points at the version just built. dist/stable points at the
newest tagged final release and is left alone for a --rc build.

A release or release candidate is allowed only on a release branch (main or
master). A final release then pushes that branch and the tag to the branch's
upstream. An --rc build does not push.

--pre builds a Python developmental pre-release from any branch. Cargo stores
``X.Y.Z-dev0+<shortsha>.<utc-timestamp>.<user>``, which PEP 440 spells
``X.Y.Z.dev0+<shortsha>.<utc-timestamp>.<user>``. It is committed and tagged,
and it is not pushed. pip and uv install it only for that exact version or
when ``--pre`` is given.

Unless --dry-run is set, the built artifacts are published with
``uv publish`` (using uv's configured index and credentials).

--rc builds a release candidate of VERSION. A plain VERSION such as 0.3.0
selects the next free candidate (0.3.0rc1, then 0.3.0rc2, from the local
tags). An explicit candidate (0.3.0rc2 or 0.3.0-rc.2) is used as given.
Cargo stores X.Y.Z-rc.N; PEP 440 spells that X.Y.ZrcN, a pre-release. pip
and uv will not install it unless that version is requested or --pre is
given. The candidate is committed and tagged. dist/latest and dist/rc point
at it.

The default interpreters are Python 3.9, 3.10, 3.11, 3.12, 3.13 and 3.14. Override them
with --python or TUES_PYTHON_VERSIONS (comma or space separated). Wheels are
built in the maturin manylinux2014 container, which carries those CPython
builds, so each wheel is tagged for that interpreter and for manylinux2014
rather than for the host glibc. Docker is required.
"""

from __future__ import annotations

import argparse
import getpass
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import List, Optional, Sequence

ROOT = Path(__file__).resolve().parent.parent
CARGO_TOML = ROOT / "Cargo.toml"
DIST = ROOT / "dist"

DEFAULT_PYTHONS = ["3.9", "3.10", "3.11", "3.12", "3.13", "3.14"]
# Releases and release candidates are cut only from these branches.
RELEASE_BRANCHES = ("main", "master")
# manylinux2014 image: maturin, stable Rust, and CPython 3.9–3.14 on PATH.
IMAGE = "ghcr.io/pyo3/maturin:v1.15.0"
# Path dependencies in Cargo.toml that pin the workspace version.
VERSIONED_PATH_DEPS = 5

VERSION_RE = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+([.+-][0-9A-Za-z.]+)?$")
PLAIN_VERSION_RE = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+$")
# Cargo stores ``0.3.0-rc.1``. PEP 440 normalizes that, and ``0.3.0rc1``,
# to the same pre-release. ``0.3.0-rc1`` is accepted on input and stored
# in the Cargo spelling.
RC_INPUT_RE = re.compile(
    r"^(?P<base>[0-9]+\.[0-9]+\.[0-9]+)(?:-rc\.|-rc|rc)(?P<n>[0-9]+)$"
)
RC_CARGO_RE = re.compile(r"^(?P<base>[0-9]+\.[0-9]+\.[0-9]+)-rc\.(?P<n>[0-9]+)$")
# Cargo stores ``0.3.0-dev0+abc1234.20261008120000.mvb``. PEP 440 spells that
# ``0.3.0.dev0+abc1234.20261008120000.mvb``, a developmental pre-release.
PRE_CARGO_RE = re.compile(
    r"^(?P<base>[0-9]+\.[0-9]+\.[0-9]+)-dev0\+"
    r"(?P<local>[0-9A-Za-z]+(?:\.[0-9A-Za-z]+)*)$"
)
PYTHON_RE = re.compile(r"^[0-9]+\.[0-9]+$")


class ReleaseError(Exception):
    def __init__(self, message: str, code: int = 1) -> None:
        super().__init__(message)
        self.code = code


def split_versions(text: str) -> List[str]:
    return [part for part in re.split(r"[,\s]+", text) if part]


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="scripts/release",
        usage=(
            "scripts/release [-d|--dry-run] [--rc | --pre] "
            "[--python 3.9,3.10,3.11,3.12,3.13,3.14] [VERSION]"
        ),
        description="Set the workspace version, tag it, and build PyPI artifacts.",
    )
    parser.add_argument(
        "-d",
        "--dry-run",
        action="store_true",
        help="print the plan and stop (skips commit, tag, build, and upload)",
    )
    parser.add_argument(
        "--rc",
        action="store_true",
        help=(
            "commit and tag the next release candidate of VERSION "
            "(0.3.0 -> 0.3.0-rc.1, published as 0.3.0rc1)"
        ),
    )
    parser.add_argument(
        "--pre",
        action="store_true",
        help=(
            "commit and tag a Python pre-release from any branch "
            "(0.3.0 -> 0.3.0-dev0+<sha>.<timestamp>.<user>, not pushed)"
        ),
    )
    parser.add_argument(
        "--python",
        metavar="VERSIONS",
        help="CPython releases to build wheels for (comma or space separated)",
    )
    parser.add_argument(
        "version",
        metavar="VERSION",
        nargs="?",
        help=(
            "release version, e.g. 0.2.0 (prompted when omitted on a TTY; "
            "--pre defaults to the current release)"
        ),
    )
    return parser.parse_args(argv)


def run(
    args: Sequence[str],
    *,
    cwd: Optional[Path] = None,
    env: Optional[dict] = None,
    capture: bool = False,
    check: bool = True,
) -> subprocess.CompletedProcess:
    return subprocess.run(
        list(args),
        cwd=str(cwd or ROOT),
        env=env,
        check=check,
        text=True,
        stdout=subprocess.PIPE if capture else None,
    )


def git(*args: str, capture: bool = False, check: bool = True) -> subprocess.CompletedProcess:
    return run(["git", *args], capture=capture, check=check)


def workspace_version() -> str:
    in_pkg = False
    for line in CARGO_TOML.read_text().splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            in_pkg = stripped == "[workspace.package]"
            continue
        if in_pkg and stripped.startswith("version = "):
            return stripped.split('"')[1]
    raise ReleaseError("workspace.package.version not found")


def rewrite_cargo_toml(old: str, new: str) -> None:
    """Bump the workspace package version and the path deps that pin it."""
    old_field = f'version = "{old}"'
    new_field = f'version = "{new}"'
    out = []
    in_pkg = False
    replaced_pkg = False
    replaced_deps = 0
    for line in CARGO_TOML.read_text().splitlines(keepends=True):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            in_pkg = stripped == "[workspace.package]"
        if in_pkg and stripped.startswith("version = "):
            line = line.replace(old_field, new_field, 1)
            replaced_pkg = new_field in line
        elif 'path = "crates/tues' in line and old_field in line:
            line = line.replace(old_field, new_field, 1)
            replaced_deps += 1
        out.append(line)
    if not replaced_pkg or replaced_deps != VERSIONED_PATH_DEPS:
        raise ReleaseError(
            f"refusing to rewrite Cargo.toml (package={replaced_pkg}, deps={replaced_deps})"
        )
    CARGO_TOML.write_text("".join(out))


def published_version(cargo_version: str) -> str:
    """The PEP 440 spelling of a version stored for Cargo.

    ``0.3.0-rc.1`` is the pre-release ``0.3.0rc1``.
    ``0.3.0-dev0+abc.20261008120000.mvb`` is ``0.3.0.dev0+abc.20261008120000.mvb``.
    """
    match = RC_CARGO_RE.match(cargo_version)
    if match:
        return f"{match.group('base')}rc{match.group('n')}"
    match = PRE_CARGO_RE.match(cargo_version)
    if match:
        return f"{match.group('base')}.dev0+{match.group('local')}"
    return cargo_version


def release_base(version: str) -> str:
    """The ``X.Y.Z`` release inside a workspace version."""
    if PLAIN_VERSION_RE.match(version):
        return version
    match = RC_CARGO_RE.match(version) or PRE_CARGO_RE.match(version)
    if match:
        return match.group("base")
    head = re.split(r"[-+]", version, maxsplit=1)[0]
    if PLAIN_VERSION_RE.match(head):
        return head
    raise ReleaseError(f"not a release version: {version}", code=2)


def version_user() -> str:
    """Login name, reduced to the characters a PEP 440 local segment allows."""
    raw = getpass.getuser()
    cleaned = re.sub(r"[^0-9A-Za-z]", "", raw).lower()
    if not cleaned:
        raise ReleaseError(f"username {raw!r} cannot be used in a version", code=2)
    return cleaned


def cargo_pre_version(base: str) -> str:
    """SemVer spelling of a developmental pre-release of ``base``.

    The local part is the short commit hash, a UTC timestamp, and the
    username, in that order. PEP 440 spells the result ``{base}.dev0+...``.
    """
    sha = git("rev-parse", "--short", "HEAD", capture=True).stdout.strip()
    if not re.fullmatch(r"[0-9a-f]+", sha):
        raise ReleaseError(f"refusing commit hash {sha!r}", code=2)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    return f"{base}-dev0+{sha}.{stamp}.{version_user()}"


def parse_rc_request(text: str) -> tuple[str, Optional[int]]:
    """Split an ``--rc`` argument into a release and an optional candidate number.

    A plain release (``0.3.0``) leaves the number unset so the caller can
    pick the next free one. ``0.3.0rc2`` and ``0.3.0-rc.2`` name one candidate.
    """
    if PLAIN_VERSION_RE.match(text):
        return text, None
    match = RC_INPUT_RE.match(text)
    if match is None:
        raise ReleaseError(
            f"a release candidate is built from a release such as 0.3.0, not {text}",
            code=2,
        )
    number = int(match.group("n"))
    if number < 1:
        raise ReleaseError("release candidate numbers start at 1", code=2)
    return match.group("base"), number


def cargo_rc_version(base: str, number: int) -> str:
    """SemVer spelling of a candidate. PEP 440 normalizes it to ``{base}rc{number}``."""
    return f"{base}-rc.{number}"


def next_rc_number(base: str) -> int:
    """One past the highest local tag for ``base``, or 1 when none exist."""
    listed = git(
        "tag", "-l", f"v{base}-rc.*", f"v{base}rc*", capture=True
    ).stdout.splitlines()
    pattern = re.compile(rf"^v{re.escape(base)}(?:-rc\.|rc)([0-9]+)$")
    highest = 0
    for tag in listed:
        match = pattern.match(tag.strip())
        if match:
            highest = max(highest, int(match.group(1)))
    return highest + 1


def restore_manifests() -> None:
    git("checkout", "--", "Cargo.toml", "Cargo.lock")


def current_branch() -> str:
    """The branch HEAD is on, or ``HEAD`` when detached."""
    return git("rev-parse", "--abbrev-ref", "HEAD", capture=True).stdout.strip()


def require_upstream(branch: str) -> None:
    """Refuse a final release whose branch has no tracking upstream."""
    result = git(
        "rev-parse",
        "--abbrev-ref",
        "@{upstream}",
        capture=True,
        check=False,
    )
    if result.returncode != 0 or not result.stdout.strip():
        raise ReleaseError(
            f"{branch} has no upstream; set one before releasing",
            code=2,
        )


def require_release_branch() -> str:
    """Refuse a release or release candidate that is not cut from a release branch."""
    branch = current_branch()
    if branch not in RELEASE_BRANCHES:
        allowed = " or ".join(RELEASE_BRANCHES)
        raise ReleaseError(
            f"a release can only be created from {allowed}, not {branch}",
            code=2,
        )
    return branch


def tag_exists(tag: str) -> bool:
    result = git("rev-parse", "-q", "--verify", f"refs/tags/{tag}", capture=True, check=False)
    return result.returncode == 0


def release_tag_name(tag: str) -> Optional[str]:
    """Return the version part of a release tag, or None if it is not one."""
    name = tag[1:] if tag.startswith("v") else tag
    if VERSION_RE.match(name) or RC_INPUT_RE.match(name):
        return name
    return None


def last_release_ref() -> Optional[tuple[str, str]]:
    """The most recent release boundary as (ref, label).

    Prefer a tag or ``Release X.Y.Z.`` commit for the current workspace
    version, so a series that tagged ``v4.0.3`` (or only committed it) is
    found even when older bare tags still exist. Fall back to the newest
    version-sorted release tag.
    """
    current = workspace_version()
    for tag in (f"v{current}", current):
        if tag_exists(tag):
            return tag, tag

    result = git(
        "log",
        "-1",
        "--format=%H",
        f"--grep=^Release {re.escape(current)}\\.$",
        capture=True,
        check=False,
    )
    commit = result.stdout.strip()
    if result.returncode == 0 and commit:
        return commit, f"Release {current}"

    listed = git("tag", "-l", "--sort=-v:refname", capture=True).stdout.splitlines()
    for tag in listed:
        if release_tag_name(tag.strip()) is not None:
            return tag.strip(), tag.strip()
    return None


def commits_since_last_release() -> tuple[Optional[str], List[str]]:
    """Return (label, subject lines) for commits after the last release."""
    boundary = last_release_ref()
    if boundary is None:
        log = git("log", "--format=%s", capture=True).stdout.splitlines()
        return None, log
    ref, label = boundary
    log = git("log", f"{ref}..HEAD", "--format=%s", capture=True).stdout.splitlines()
    return label, log


def prompt_version(*, candidate: bool) -> str:
    """Print commits since the last release and ask for a VERSION on a TTY."""
    if not sys.stdin.isatty():
        raise ReleaseError("VERSION is required when stdin is not a TTY", code=2)

    label, subjects = commits_since_last_release()
    current = workspace_version()
    print(f"Current workspace version: {current}")
    if label is None:
        print("No previous release tag or commit found.")
    else:
        print(f"Commits since {label}:")
    if not subjects:
        print("  (none)")
    else:
        for subject in subjects:
            print(f"  {subject}")
    print()
    if candidate:
        prompt = "Upcoming release or candidate (e.g. 0.3.0 or 0.3.0rc2): "
    else:
        prompt = "Release version (e.g. 0.2.0): "
    try:
        given = input(prompt).strip()
    except EOFError as exc:
        raise ReleaseError("no version entered", code=2) from exc
    if not given:
        raise ReleaseError("no version entered", code=2)
    return given


def version_directory(name: str) -> Path:
    """``dist/<name>``, refusing names that could escape that directory."""
    if (
        not name
        or name in (".", "..", "latest", "stable", "rc")
        or "/" in name
        or "\\" in name
    ):
        raise ReleaseError(f"refusing version directory {name!r}")
    return DIST / name


def prepare_version_dir(name: str) -> Path:
    """Replace ``dist/<name>`` with an empty directory. Other versions stay."""
    path = version_directory(name)
    if path.is_symlink():
        raise ReleaseError(f"{path} is a symlink")
    DIST.mkdir(exist_ok=True)
    if path.exists():
        shutil.rmtree(path)
    path.mkdir()
    return path


def retarget(link_name: str, version_name: str) -> None:
    """Point ``dist/<link_name>`` at ``dist/<version_name>``."""
    version_directory(version_name)
    DIST.mkdir(exist_ok=True)
    link = DIST / link_name
    if link.is_symlink() or (link.exists() and not link.is_dir()):
        link.unlink()
    elif link.is_dir():
        raise ReleaseError(f"{link} is a directory; not replacing it with a symlink")
    temporary = DIST / f".{link_name}.tmp"
    if temporary.is_symlink() or temporary.exists():
        temporary.unlink()
    temporary.symlink_to(version_name)
    temporary.replace(link)


def publish(name: str, *, stable: bool = False, candidate: bool = False) -> None:
    """Point dist/latest at this version.

    A final release also claims dist/stable. A release candidate claims
    dist/rc and leaves dist/stable on the last final release, so the default
    upload path does not start serving the candidate.
    """
    retarget("latest", name)
    if stable:
        retarget("stable", name)
    if candidate:
        retarget("rc", name)


def build(pythons: Sequence[str], version_name: str) -> Path:
    """Build the sdist and one wheel per interpreter inside the manylinux image.

    Artifacts land in ``dist/<version_name>/``. Other version directories are
    left in place. The container's glibc is 2.17, so the wheels are tagged
    manylinux2014. Cargo's download cache lives in a named volume.
    """
    if shutil.which("docker") is None:
        raise ReleaseError("docker is required to build the release wheels")
    out = prepare_version_dir(version_name)
    relative = out.relative_to(ROOT).as_posix()
    # One sdist, then a wheel per interpreter built from it. `--locked` is
    # not passed: the sdist drops the CLI-only crates, so its workspace no
    # longer matches the repo lock file and Cargo prunes that locally.
    cmd = [
        "docker", "run", "--rm",
        "-v", f"{ROOT}:/io",
        "-w", "/io",
        "-e", "CARGO_HOME=/tmp/cargo",
        "-e", "CARGO_TARGET_DIR=/tmp/target",
        "-v", "tues-release-cargo:/tmp/cargo",
        IMAGE,
        "build",
        "--release", "--strip", "--sdist",
        "--compatibility", "manylinux2014",
        "--out", relative,
    ]
    for py in pythons:
        cmd += ["-i", f"python{py}"]
    print(f"Building wheels in {IMAGE}", flush=True)
    run(cmd)
    claim_dist(relative)
    return out


def docker_rootless() -> bool:
    info = run(["docker", "info", "-f", "{{.SecurityOptions}}"], capture=True).stdout
    return "rootless" in info


def claim_dist(relative: str) -> None:
    """Make one dist subdirectory belong to the user who ran the script.

    Rootless Docker already maps container root to that user, and chowning to
    the host uid from inside the container lands on nobody. A rootful daemon
    really does write as host root, so those artifacts are handed back.
    """
    if docker_rootless():
        return
    run(
        [
            "docker", "run", "--rm",
            "--entrypoint", "chown",
            "-v", f"{ROOT}:/io",
            IMAGE,
            "-R", f"{os.getuid()}:{os.getgid()}", f"/io/{relative}",
        ]
    )


def show_artifacts(directory: Path) -> None:
    print()
    print(f"Artifacts in {directory.relative_to(ROOT)}/:")
    for artifact in sorted(directory.iterdir()):
        print(artifact.name)


def upload_artifacts(directory: Path) -> None:
    """Publish every file in ``directory`` with ``uv publish``."""
    artifacts = sorted(path for path in directory.iterdir() if path.is_file())
    if not artifacts:
        raise ReleaseError(f"no artifacts in {directory}")
    run(["uv", "publish", *(str(path) for path in artifacts)])


def main(argv: Sequence[str]) -> int:
    args = parse_args(argv)

    pythons = DEFAULT_PYTHONS
    if os.environ.get("TUES_PYTHON_VERSIONS"):
        pythons = split_versions(os.environ["TUES_PYTHON_VERSIONS"])
    if args.python is not None:
        pythons = split_versions(args.python)
    if not pythons:
        raise ReleaseError("no Python versions given", code=2)
    for py in pythons:
        if not PYTHON_RE.match(py):
            raise ReleaseError(f"not a Python version: {py}", code=2)

    if args.rc and args.pre:
        raise ReleaseError("--rc and --pre cannot be combined", code=2)

    given = args.version
    if given is None and not args.pre:
        given = prompt_version(candidate=args.rc)
    if given is not None:
        given = given[1:] if given.startswith("v") else given

    current = workspace_version()
    candidate = False
    prerelease = False
    if args.pre:
        base = given if given is not None else release_base(current)
        if not PLAIN_VERSION_RE.match(base):
            raise ReleaseError(
                f"a pre-release is built from a release such as 0.3.0, not {base}",
                code=2,
            )
        version = cargo_pre_version(base)
        prerelease = True
    elif args.rc:
        base, number = parse_rc_request(given)
        if number is None:
            number = next_rc_number(base)
        version = cargo_rc_version(base, number)
        candidate = True
    else:
        if not VERSION_RE.match(given):
            raise ReleaseError(f"not a version: {given}", code=2)
        version = given
        candidate = RC_CARGO_RE.match(version) is not None
    tag = f"v{version}"
    if prerelease:
        branch = current_branch()
    else:
        branch = require_release_branch()
        if not candidate:
            require_upstream(branch)

    if git("status", "--porcelain", capture=True).stdout.strip():
        if not args.dry_run:
            raise ReleaseError("working tree is not clean")
        print("working tree is not clean; a real run would stop here", file=sys.stderr)

    public = published_version(version)
    wheels = (
        f"would build one wheel per Python {' '.join(pythons)}, plus an sdist, "
        f"in {IMAGE} and write them to dist/{public}/"
    )

    need_commit = False
    need_tag = False
    if tag_exists(tag):
        if current != version:
            raise ReleaseError(
                f"tag {tag} already exists, but the workspace version is {current}"
            )
    else:
        need_tag = True
        need_commit = current != version

    if args.dry_run:
        shown = version if version == public else f"{version} ({public})"
        if need_commit:
            print(f"would commit version {current} -> {shown}")
        if need_tag:
            print(f"would tag {tag}")
        else:
            print(f"tag {tag} already exists")
        print(wheels)
        if prerelease:
            print(f"would point dist/latest at {public}")
            print("would leave dist/stable and dist/rc unchanged")
            print(f"would not push {branch} or {tag}")
            print(
                f"{public} is a pre-release: pip and uv install it only for "
                f"tues=={public} or when --pre is given"
            )
        elif candidate:
            print(f"would point dist/latest and dist/rc at {public}")
            print("would leave dist/stable unchanged")
            print(
                f"{public} is a pre-release: pip and uv install it only for "
                f"tues=={public} or when --pre is given"
            )
        else:
            print(f"would point dist/latest and dist/stable at {public}")
            print(f"would push {branch} and {tag} to its upstream")
        print(f"would upload dist/{public}/* with uv publish")
        return 0

    if need_commit:
        rewrite_cargo_toml(current, version)
        refreshed = run(
            ["cargo", "metadata", "--offline", "--format-version", "1"],
            capture=True,
            check=False,
        )
        if refreshed.returncode != 0:
            restore_manifests()
            raise ReleaseError("cargo metadata rejected the new version; Cargo.toml restored")
        git("add", "Cargo.toml", "Cargo.lock")
        git("commit", "-m", f"Release {version}.")
    if need_tag:
        git("tag", "-a", tag, "-m", f"tues {version}")
        print(f"tagged {tag}")

    out = build(pythons, public)
    publish(public, stable=not candidate and not prerelease, candidate=candidate)

    show_artifacts(out)
    print()
    print(f"dist/latest -> {public}")
    if prerelease:
        print("dist/stable and dist/rc are unchanged")
    elif candidate:
        print(f"dist/rc -> {public}")
    else:
        print(f"dist/stable -> {public}")
    print()
    if prerelease:
        print(f"{branch} and {tag} are not pushed")
    elif candidate:
        print("The tag is local. Publish it with:")
        print("  git push --follow-tags")
    else:
        git("push", "--follow-tags")
        print(f"pushed {branch} and {tag}")
    print()
    if prerelease or candidate:
        print(
            f"{public} is a pre-release. pip and uv will not install it unless "
            f"the version is requested (tues=={public}) or --pre is given."
        )
        print()
    upload_artifacts(out)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except ReleaseError as exc:
        print(exc, file=sys.stderr)
        sys.exit(exc.code)
    except subprocess.CalledProcessError as exc:
        print(f"{exc.cmd[0]} exited with {exc.returncode}", file=sys.stderr)
        sys.exit(exc.returncode or 1)
