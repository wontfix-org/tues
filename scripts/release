#!/usr/bin/env python3
"""Set the workspace version, tag it, and build PyPI artifacts.

Usage: scripts/release [--dry-run] [--preview] [--rc] [--upload]
                       [--python 3.9,3.11,3.12,3.13] [VERSION]

VERSION is a dotted release such as 0.2.0 (a leading "v" is accepted and
stripped). The script commits the version bump, creates an annotated tag
vVERSION, and writes a release sdist plus one wheel per configured CPython
to dist/<version>/. It does not push the tag. dist/latest points at the
version just built. dist/stable points at the newest tagged final release
and is left alone for a --preview or --rc build.

--upload publishes the built artifacts with ``uv publish`` (using uv's
configured index and credentials). Without it, the script prints the
upload command instead.

--preview builds VERSION.post1.dev1+$USER.$ISODATE.$COMMIT instead, from the
workspace version when VERSION is omitted. That build is not committed or
tagged, and the manifest is restored afterwards. The manifest itself uses a
hyphen (`-post1`) because Cargo versions are SemVer; PEP 440 normalizes it
back to `.post1`. The local part is dot-separated: a second `+` is not a
legal version character.

--rc builds a release candidate of VERSION. A plain VERSION such as 0.3.0
selects the next free candidate (0.3.0rc1, then 0.3.0rc2, from the local
tags). An explicit candidate (0.3.0rc2 or 0.3.0-rc.2) is used as given.
Cargo stores X.Y.Z-rc.N; PEP 440 spells that X.Y.ZrcN, a pre-release. pip
and uv will not install it unless that version is requested or --pre is
given. The candidate is committed and tagged. dist/latest and dist/rc point
at it.

The default interpreters are Python 3.9, 3.11, 3.12 and 3.13. Override them
with --python or TUES_PYTHON_VERSIONS (comma or space separated). Wheels are
built in the maturin manylinux2014 container, which carries those CPython
builds, so each wheel is tagged for that interpreter and for manylinux2014
rather than for the host glibc. Docker is required.
"""

from __future__ import annotations

import argparse
import getpass
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import List, Optional, Sequence

ROOT = Path(__file__).resolve().parent.parent
CARGO_TOML = ROOT / "Cargo.toml"
DIST = ROOT / "dist"

DEFAULT_PYTHONS = ["3.9", "3.11", "3.12", "3.13"]
# manylinux2014 image: maturin, stable Rust, and CPython 3.9–3.13 on PATH.
IMAGE = "ghcr.io/pyo3/maturin:v1.15.0"
# Path dependencies in Cargo.toml that pin the workspace version.
VERSIONED_PATH_DEPS = 5

VERSION_RE = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+([.+-][0-9A-Za-z.]+)?$")
PLAIN_VERSION_RE = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+$")
# Cargo stores ``0.3.0-rc.1``. PEP 440 normalizes that, and ``0.3.0rc1``,
# to the same pre-release. ``0.3.0-rc1`` is accepted on input and stored
# in the Cargo spelling.
RC_INPUT_RE = re.compile(
    r"^(?P<base>[0-9]+\.[0-9]+\.[0-9]+)(?:-rc\.|-rc|rc)(?P<n>[0-9]+)$"
)
RC_CARGO_RE = re.compile(r"^(?P<base>[0-9]+\.[0-9]+\.[0-9]+)-rc\.(?P<n>[0-9]+)$")
PYTHON_RE = re.compile(r"^[0-9]+\.[0-9]+$")


class ReleaseError(Exception):
    def __init__(self, message: str, code: int = 1) -> None:
        super().__init__(message)
        self.code = code


def split_versions(text: str) -> List[str]:
    return [part for part in re.split(r"[,\s]+", text) if part]


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="scripts/release",
        usage=(
            "scripts/release [--dry-run] [--preview] [--rc] [--upload] "
            "[--python 3.9,3.11,3.12,3.13] [VERSION]"
        ),
        description="Set the workspace version, tag it, and build PyPI artifacts.",
    )
    parser.add_argument("--dry-run", action="store_true", help="print the plan and stop")
    parser.add_argument(
        "--preview",
        action="store_true",
        help=(
            "build VERSION.post1.dev1+$USER.$YYYYMMDD.$COMMIT without committing "
            "or tagging (VERSION defaults to the workspace version)"
        ),
    )
    parser.add_argument(
        "--rc",
        action="store_true",
        help=(
            "commit and tag the next release candidate of VERSION "
            "(0.3.0 -> 0.3.0-rc.1, published as 0.3.0rc1)"
        ),
    )
    parser.add_argument(
        "--upload",
        action="store_true",
        help="upload built artifacts with uv publish",
    )
    parser.add_argument(
        "--python",
        metavar="VERSIONS",
        help="CPython releases to build wheels for (comma or space separated)",
    )
    parser.add_argument(
        "version",
        nargs="?",
        metavar="VERSION",
        help="release version, e.g. 0.2.0; optional with --preview",
    )
    return parser.parse_args(argv)


def run(
    args: Sequence[str],
    *,
    cwd: Optional[Path] = None,
    env: Optional[dict] = None,
    capture: bool = False,
    check: bool = True,
) -> subprocess.CompletedProcess:
    return subprocess.run(
        list(args),
        cwd=str(cwd or ROOT),
        env=env,
        check=check,
        text=True,
        stdout=subprocess.PIPE if capture else None,
    )


def git(*args: str, capture: bool = False, check: bool = True) -> subprocess.CompletedProcess:
    return run(["git", *args], capture=capture, check=check)


def workspace_version() -> str:
    in_pkg = False
    for line in CARGO_TOML.read_text().splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            in_pkg = stripped == "[workspace.package]"
            continue
        if in_pkg and stripped.startswith("version = "):
            return stripped.split('"')[1]
    raise ReleaseError("workspace.package.version not found")


def rewrite_cargo_toml(old: str, new: str) -> None:
    """Bump the workspace package version and the path deps that pin it."""
    old_field = f'version = "{old}"'
    new_field = f'version = "{new}"'
    out = []
    in_pkg = False
    replaced_pkg = False
    replaced_deps = 0
    for line in CARGO_TOML.read_text().splitlines(keepends=True):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            in_pkg = stripped == "[workspace.package]"
        if in_pkg and stripped.startswith("version = "):
            line = line.replace(old_field, new_field, 1)
            replaced_pkg = new_field in line
        elif 'path = "crates/tues' in line and old_field in line:
            line = line.replace(old_field, new_field, 1)
            replaced_deps += 1
        out.append(line)
    if not replaced_pkg or replaced_deps != VERSIONED_PATH_DEPS:
        raise ReleaseError(
            f"refusing to rewrite Cargo.toml (package={replaced_pkg}, deps={replaced_deps})"
        )
    CARGO_TOML.write_text("".join(out))


def preview_version(base: str) -> str:
    """Cargo spelling of ``base.post1.dev1+user.date.commit``.

    PEP 440 treats ``-post1`` and ``.post1`` as the same public version. The
    local segments stay dot-separated so the string is one legal version.
    """
    if not PLAIN_VERSION_RE.match(base):
        raise ReleaseError(
            f"a preview is built from a plain release version, not {base}", code=2
        )
    # $USER when the environment has it; otherwise the login name.
    user = re.sub(r"[^0-9A-Za-z]", "", getpass.getuser())
    if not user:
        raise ReleaseError("the user name has no letters or digits", code=2)
    today = datetime.now(timezone.utc).strftime("%Y%m%d")
    commit = git("rev-parse", "--short", "HEAD", capture=True).stdout.strip()
    if not re.fullmatch(r"[0-9a-fA-F]+", commit):
        raise ReleaseError(f"not a commit hash: {commit}")
    return f"{base}-post1.dev1+{user}.{today}.{commit}"


def published_version(cargo_version: str) -> str:
    """The PEP 440 spelling of a version stored for Cargo.

    ``0.3.0-rc.1`` is the pre-release ``0.3.0rc1``. ``-post1`` is the public
    ``.post1`` used by preview builds.
    """
    match = RC_CARGO_RE.match(cargo_version)
    if match:
        return f"{match.group('base')}rc{match.group('n')}"
    return cargo_version.replace("-post1.", ".post1.", 1)


def parse_rc_request(text: str) -> tuple[str, Optional[int]]:
    """Split an ``--rc`` argument into a release and an optional candidate number.

    A plain release (``0.3.0``) leaves the number unset so the caller can
    pick the next free one. ``0.3.0rc2`` and ``0.3.0-rc.2`` name one candidate.
    """
    if PLAIN_VERSION_RE.match(text):
        return text, None
    match = RC_INPUT_RE.match(text)
    if match is None:
        raise ReleaseError(
            f"a release candidate is built from a release such as 0.3.0, not {text}",
            code=2,
        )
    number = int(match.group("n"))
    if number < 1:
        raise ReleaseError("release candidate numbers start at 1", code=2)
    return match.group("base"), number


def cargo_rc_version(base: str, number: int) -> str:
    """SemVer spelling of a candidate. PEP 440 normalizes it to ``{base}rc{number}``."""
    return f"{base}-rc.{number}"


def next_rc_number(base: str) -> int:
    """One past the highest local tag for ``base``, or 1 when none exist."""
    listed = git(
        "tag", "-l", f"v{base}-rc.*", f"v{base}rc*", capture=True
    ).stdout.splitlines()
    pattern = re.compile(rf"^v{re.escape(base)}(?:-rc\.|rc)([0-9]+)$")
    highest = 0
    for tag in listed:
        match = pattern.match(tag.strip())
        if match:
            highest = max(highest, int(match.group(1)))
    return highest + 1


def restore_manifests() -> None:
    git("checkout", "--", "Cargo.toml", "Cargo.lock")


def tag_exists(tag: str) -> bool:
    result = git("rev-parse", "-q", "--verify", f"refs/tags/{tag}", capture=True, check=False)
    return result.returncode == 0


def version_directory(name: str) -> Path:
    """``dist/<name>``, refusing names that could escape that directory."""
    if (
        not name
        or name in (".", "..", "latest", "stable", "rc")
        or "/" in name
        or "\\" in name
    ):
        raise ReleaseError(f"refusing version directory {name!r}")
    return DIST / name


def prepare_version_dir(name: str) -> Path:
    """Replace ``dist/<name>`` with an empty directory. Other versions stay."""
    path = version_directory(name)
    if path.is_symlink():
        raise ReleaseError(f"{path} is a symlink")
    DIST.mkdir(exist_ok=True)
    if path.exists():
        shutil.rmtree(path)
    path.mkdir()
    return path


def retarget(link_name: str, version_name: str) -> None:
    """Point ``dist/<link_name>`` at ``dist/<version_name>``."""
    version_directory(version_name)
    DIST.mkdir(exist_ok=True)
    link = DIST / link_name
    if link.is_symlink() or (link.exists() and not link.is_dir()):
        link.unlink()
    elif link.is_dir():
        raise ReleaseError(f"{link} is a directory; not replacing it with a symlink")
    temporary = DIST / f".{link_name}.tmp"
    if temporary.is_symlink() or temporary.exists():
        temporary.unlink()
    temporary.symlink_to(version_name)
    temporary.replace(link)


def publish(name: str, *, stable: bool = False, candidate: bool = False) -> None:
    """Point dist/latest at this version.

    A final release also claims dist/stable. A release candidate claims
    dist/rc and leaves dist/stable on the last final release, so the default
    upload path does not start serving the candidate.
    """
    retarget("latest", name)
    if stable:
        retarget("stable", name)
    if candidate:
        retarget("rc", name)


def build(pythons: Sequence[str], version_name: str) -> Path:
    """Build the sdist and one wheel per interpreter inside the manylinux image.

    Artifacts land in ``dist/<version_name>/``. Other version directories are
    left in place. The container's glibc is 2.17, so the wheels are tagged
    manylinux2014. Cargo's download cache lives in a named volume.
    """
    if shutil.which("docker") is None:
        raise ReleaseError("docker is required to build the release wheels")
    out = prepare_version_dir(version_name)
    relative = out.relative_to(ROOT).as_posix()
    # One sdist, then a wheel per interpreter built from it. `--locked` is
    # not passed: the sdist drops the CLI-only crates, so its workspace no
    # longer matches the repo lock file and Cargo prunes that locally.
    cmd = [
        "docker", "run", "--rm",
        "-v", f"{ROOT}:/io",
        "-w", "/io",
        "-e", "CARGO_HOME=/tmp/cargo",
        "-e", "CARGO_TARGET_DIR=/tmp/target",
        "-v", "tues-release-cargo:/tmp/cargo",
        IMAGE,
        "build",
        "--release", "--strip", "--sdist",
        "--compatibility", "manylinux2014",
        "--out", relative,
    ]
    for py in pythons:
        cmd += ["-i", f"python{py}"]
    print(f"Building wheels in {IMAGE}", flush=True)
    run(cmd)
    claim_dist(relative)
    return out


def docker_rootless() -> bool:
    info = run(["docker", "info", "-f", "{{.SecurityOptions}}"], capture=True).stdout
    return "rootless" in info


def claim_dist(relative: str) -> None:
    """Make one dist subdirectory belong to the user who ran the script.

    Rootless Docker already maps container root to that user, and chowning to
    the host uid from inside the container lands on nobody. A rootful daemon
    really does write as host root, so those artifacts are handed back.
    """
    if docker_rootless():
        return
    run(
        [
            "docker", "run", "--rm",
            "--entrypoint", "chown",
            "-v", f"{ROOT}:/io",
            IMAGE,
            "-R", f"{os.getuid()}:{os.getgid()}", f"/io/{relative}",
        ]
    )


def show_artifacts(directory: Path) -> None:
    print()
    print(f"Artifacts in {directory.relative_to(ROOT)}/:")
    for artifact in sorted(directory.iterdir()):
        print(artifact.name)


def upload_artifacts(directory: Path) -> None:
    """Publish every file in ``directory`` with ``uv publish``."""
    artifacts = sorted(path for path in directory.iterdir() if path.is_file())
    if not artifacts:
        raise ReleaseError(f"no artifacts in {directory}")
    run(["uv", "publish", *(str(path) for path in artifacts)])


def print_upload_hint(link_name: str) -> None:
    print("Upload the artifacts with:")
    print(f"  uv publish dist/{link_name}/*")
    print("or pass --upload.")


def main(argv: Sequence[str]) -> int:
    args = parse_args(argv)

    pythons = DEFAULT_PYTHONS
    if os.environ.get("TUES_PYTHON_VERSIONS"):
        pythons = split_versions(os.environ["TUES_PYTHON_VERSIONS"])
    if args.python is not None:
        pythons = split_versions(args.python)
    if not pythons:
        raise ReleaseError("no Python versions given", code=2)
    for py in pythons:
        if not PYTHON_RE.match(py):
            raise ReleaseError(f"not a Python version: {py}", code=2)

    if args.preview and args.rc:
        raise ReleaseError("pass only one of --preview and --rc", code=2)
    if args.version is None and not args.preview:
        raise ReleaseError("a version is required (or pass --preview)", code=2)
    given = None
    if args.version is not None:
        given = args.version[1:] if args.version.startswith("v") else args.version

    current = workspace_version()
    candidate = False
    if args.preview:
        if given is not None and not VERSION_RE.match(given):
            raise ReleaseError(f"not a version: {args.version}", code=2)
        version = preview_version(given if given is not None else current)
    elif args.rc:
        assert given is not None
        base, number = parse_rc_request(given)
        if number is None:
            number = next_rc_number(base)
        version = cargo_rc_version(base, number)
        candidate = True
    else:
        assert given is not None
        if not VERSION_RE.match(given):
            raise ReleaseError(f"not a version: {args.version}", code=2)
        version = given
        candidate = RC_CARGO_RE.match(version) is not None
    tag = f"v{version}"

    if git("status", "--porcelain", capture=True).stdout.strip():
        if not args.dry_run:
            raise ReleaseError("working tree is not clean")
        print("working tree is not clean; a real run would stop here", file=sys.stderr)

    public = published_version(version)
    wheels = (
        f"would build one wheel per Python {' '.join(pythons)}, plus an sdist, "
        f"in {IMAGE} and write them to dist/{public}/"
    )
    upload_target = "latest" if args.preview else ("rc" if candidate else "stable")
    if args.preview:
        if args.dry_run:
            print(f"would set version {current} -> {public} for the build only")
            print("would not commit or tag, and would restore Cargo.toml and Cargo.lock")
            print(wheels)
            print(f"would point dist/latest at {public}")
            if args.upload:
                print(f"would upload dist/{public}/* with uv publish")
            return 0
        print(f"preview {public}")
        rewrite_cargo_toml(current, version)
        try:
            refreshed = run(
                ["cargo", "metadata", "--offline", "--format-version", "1"],
                capture=True,
                check=False,
            )
            if refreshed.returncode != 0:
                raise ReleaseError("cargo metadata rejected the preview version")
            out = build(pythons, public)
            publish(public, stable=False)
        finally:
            restore_manifests()
        show_artifacts(out)
        print()
        print(f"dist/latest -> {public}")
        print("The preview version was not committed.")
        if args.upload:
            upload_artifacts(out)
        else:
            print_upload_hint(upload_target)
        return 0

    need_commit = False
    need_tag = False
    if tag_exists(tag):
        if current != version:
            raise ReleaseError(
                f"tag {tag} already exists, but the workspace version is {current}"
            )
    else:
        need_tag = True
        need_commit = current != version

    if args.dry_run:
        shown = version if version == public else f"{version} ({public})"
        if need_commit:
            print(f"would commit version {current} -> {shown}")
        if need_tag:
            print(f"would tag {tag}")
        else:
            print(f"tag {tag} already exists")
        print(wheels)
        if candidate:
            print(f"would point dist/latest and dist/rc at {public}")
            print("would leave dist/stable unchanged")
            print(
                f"{public} is a pre-release: pip and uv install it only for "
                f"tues=={public} or when --pre is given"
            )
        else:
            print(f"would point dist/latest and dist/stable at {public}")
        if args.upload:
            print(f"would upload dist/{public}/* with uv publish")
        return 0

    if need_commit:
        rewrite_cargo_toml(current, version)
        refreshed = run(
            ["cargo", "metadata", "--offline", "--format-version", "1"],
            capture=True,
            check=False,
        )
        if refreshed.returncode != 0:
            restore_manifests()
            raise ReleaseError("cargo metadata rejected the new version; Cargo.toml restored")
        git("add", "Cargo.toml", "Cargo.lock")
        git("commit", "-m", f"Release {version}.")
    if need_tag:
        git("tag", "-a", tag, "-m", f"tues {version}")
        print(f"tagged {tag}")

    out = build(pythons, public)
    publish(public, stable=not candidate, candidate=candidate)

    show_artifacts(out)
    print()
    print(f"dist/latest -> {public}")
    if candidate:
        print(f"dist/rc -> {public}")
    else:
        print(f"dist/stable -> {public}")
    print()
    print("The tag is local. Publish it with:")
    print(f"  git push origin HEAD {tag}")
    print()
    if candidate:
        print(
            f"{public} is a pre-release. pip and uv will not install it unless "
            f"the version is requested (tues=={public}) or --pre is given."
        )
        print()
    if args.upload:
        upload_artifacts(out)
    else:
        print_upload_hint(upload_target)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except ReleaseError as exc:
        print(exc, file=sys.stderr)
        sys.exit(exc.code)
    except subprocess.CalledProcessError as exc:
        print(f"{exc.cmd[0]} exited with {exc.returncode}", file=sys.stderr)
        sys.exit(exc.returncode or 1)
